# Core AI
AI_BAILIAN_API_KEY=your_dashscope_api_key
AI_MODEL=qwen-plus
VOICE_QWEN_MODEL=qwen3-tts-instruct-flash

# Admin account
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_admin_password

# Business settings
APP_MOCK_INTERVIEW_URL=https://your-domain.com/mock-interview
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8

# Mail verification
APP_MAIL_ENABLED=true
APP_MAIL_HOST=smtp.resend.com
APP_MAIL_PORT=465
APP_MAIL_USERNAME=resend
APP_MAIL_PASSWORD=your_smtp_password
APP_MAIL_FROM=verify@your-domain.com
APP_MAIL_SENDER_NAME=Your App Verification
APP_MAIL_SMTP_AUTH=true
APP_MAIL_SMTP_SSL_ENABLE=true
APP_MAIL_SMTP_STARTTLS=false

# Turnstile
APP_TURNSTILE_ENABLED=false
APP_TURNSTILE_SECRET_KEY=your_turnstile_secret_key
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Database / cache / object storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=interview_guide
APP_STORAGE_ENDPOINT=http://minio:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=us-east-1

# Internal voice runtime config
APP_INTERNAL_VOICE_TOKEN=replace_with_internal_token
VOICE_RUNTIME_CONFIG_URL=http://app:8080/api/internal/voice/runtime-ai-config

# Frontend / CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80,http://localhost:5173,http://localhost:5174
